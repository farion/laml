// Compact sequence: calls, replies, fragments, a note and two lifeline endings.
settings {
    type: sequence
}
semantics {
    Browser(label="Browser"; style-classes=client)
    API(label="Orders API"; style-classes=service)
    DB(label="Database")
    Worker(label="Worker")

    @request Browser -> API+ : POST /orders
    at[request.receive] : invariant="authenticated"
    hint: note "Order processing begins."
    @lookup API -> DB+ : load cart
    @found API <-- DB : cart data
    DB-
    alt "cart valid" {
        @reserve API ->> Worker : reserve stock
        API -> API : calculate total
    }
    else "cart expired" {
        API ->> Browser : request new cart
    }
    loop(min=0; max=2; guard="payment pending") {
        @payment API -> DB+ : authorize payment
        @paid API <-- DB : approved
        DB-
    }
    API-
    @response Browser <-- API : 201 Created
    Browser ->> Worker : subscribe
    Browser!
    Worker -> ? : webhook
    Worker!
}
layout {
    Browser < API : gap=48
    API < DB : gap=48
    DB < Worker : gap=48
    hint right of API : gap=12
}
styling {
    node.client {
        fill: "#e4f1ff"
    }
    node.service {
        fill: "#e9f7ee"
        border-color: "#2c7854"
    }
    relation[request] {
        color: "#245780"
        width: 3
    }
    fragment {
        fill: "#f8f9fc"
    }
    note[hint] {
        fill: "#fff4da"
    }
}
