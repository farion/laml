// Adapted from the Internet Banking System C4 component example.
// Simon Brown, c4model.com/example/ — CC BY 4.0. Descriptions are paraphrased.
settings {
    type: c4-component
    scope: Backend
}
semantics {
    system Banking(label="Internet Banking System"; description="Digital banking for customers") {
        container UI(label="UI"; technology="Angular"; appearance="browser"; description="Shows banking features")
        container Backend(label="Backend"; technology="Java / Spring"; appearance="terminal"; description="Provides banking APIs") {
        component SignIn(label="Sign In API"; technology="Spring MVC"; description="Handles customer sign-in")
        component Accounts(label="Accounts Summary API"; technology="Spring MVC"; description="Exposes account balances")
        component Email(label="Email Component"; technology="Spring Bean"; description="Sends customer notifications")
        component Security(label="Security Component"; technology="Spring Bean"; description="Verifies identities and tokens")
        component Adapter(label="Core Banking Adapter"; technology="Spring Bean"; description="Connects to core banking")
    }
        container Database(label="Database"; technology="MySQL"; appearance="database"; description="Stores access records")
    }
    external system Core(label="Core Banking System"; description="Processes accounts and transactions")
    external system Mail(label="AWS Simple Email Service"; description="Delivers outgoing email")

    @notify Banking.Backend.Email -> Mail : Sends email
    @signin(technology="JSON/HTTPS") Banking.UI -> Banking.Backend.SignIn : Signs customers in via
    @accounts(technology="JSON/HTTPS") Banking.UI -> Banking.Backend.Accounts : Requests balances via
    Banking.Backend.SignIn -> Banking.Backend.Security : Checks credentials
    Banking.Backend.Accounts -> Banking.Backend.Adapter : Fetches balances through
    Banking.Backend.Adapter -> Core : Calls core banking API
    Banking.Backend.Security -> Banking.Database : Stores access records in
}
layout {
    Banking.Backend.SignIn < Banking.Backend.Accounts : align=center; gap=115
    Banking.Backend.SignIn ^ Banking.Backend.Security : align=center; gap=80
    Banking.Backend.Accounts ^ Banking.Backend.Adapter : align=center; gap=80
    Banking.Backend.Accounts < Banking.Backend.Email : align=center; gap=115
    Banking.UI ^ Banking.Backend.SignIn : align=center; gap=85
    Banking.Backend.Adapter < Core : align=center; gap=200
    Banking.Backend.Email < Mail : align=center; gap=200
    Banking.Backend.Security ^ Banking.Database : align=center; gap=100
    relation[notify].source : side=right
    relation[notify].target : side=left
}
