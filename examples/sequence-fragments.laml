// Branching, loop, and parallel fragment frames.
settings {
    type: sequence
}
semantics {
    Client
    API
    Worker

    Client -> API : GET /orders
    alt "found" {
        <-- : 200 OK
    }
    else "missing" {
        <-- : 404 Not Found
    }
    loop(min=1; max=3; guard="pending work") {
        API ->> Worker : retry work
    }
    par "notify" {
        API ->> Worker : publish
    }
    and "audit" {
        API ->> Client : event
    }
}
