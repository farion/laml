// Compact class showcase: association, composition, dependency and template notation.
settings {
    type: class
}
semantics {
    package Domain {
        class Customer(style-classes=actor) {
            +name: String
        }
        abstract class Order<T:Class=String>(style-classes=core) {
            +id: UUID
            --
            abstract +total(): Money
        }
        class Line(style-classes=core) {
            +sku: String
            +quantity: Int
        }
        interface Pricing(style-classes=contract) {
            +quote(): Money
        }
    }
    @placed Domain.Customer "1"/customer -- "0..*"/+orders Domain.Order : places
    @owns Domain.Order "1" *-- "1..*" Domain.Line
    @priced Domain.Order ..> Domain.Pricing : quote
}
layout {
    Domain.Customer < Domain.Order : align=center; gap=155
    Domain.Order < Domain.Line : align=center; gap=155
    Domain.Order above Domain.Pricing : align=center; gap=100
}
styling {
    node.actor {
        fill: "#f6f1e8"
        border-color: "#8b6a45"
    }
    node.core {
        fill: "#e4f1ff"
        border-color: "#28628b"
    }
    node.contract {
        fill: "#eaf5ee"
        border-color: "#2b7857"
    }
    relation[owns] {
        color: "#29647c"
    }
}
