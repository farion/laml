# Basic sequence diagram: calls, replies, an interaction use, and a self-message.
settings {
    type: sequence
}
semantics {
    Client(label="Browser")
    API(label="Orders API")

    Client -> API+ : GET /orders
    <-- : 200 OK
    Client ->> API : notify
    ref "Reconcile inventory"
    API -> API : retry
}
layout {
    Client < API : gap=80
}
